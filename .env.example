# Copia a .env y rellena. El servidor MCP corre FUERA del sandbox, así que
# aquí sí se leen estas variables (a diferencia de las skills).

# Clave de API. Se acepta cualquiera de los dos nombres:
JEV_API_KEY=apikey_xxxxxxxxxxxxxxxxxxxxx
# TYPESAFE_API_KEY=...

# Endpoint. Por defecto el oficial de TypeSafe. Cambia si usas un wrapper.
JEV_BASE_URL=https://api.typesafe.ai/v1/systemone

# Modelo y timeout (opcionales)
JEV_MODEL=jev-latest
JEV_TIMEOUT=30

# Transporte MCP: stdio (Claude Code / Desktop / OpenCode) o
# streamable-http (conector HTTP personalizado en este chat).
JEV_TRANSPORT=stdio
JEV_HTTP_HOST=127.0.0.1
JEV_HTTP_PORT=8787

# Logging estructurado (JSON a stderr) y reintentos con backoff exponencial
# para errores transitorios (red, timeout, 429, 5xx). Los errores permanentes
# (4xx que no sea 429, JSON inválido) fallan a la primera, sin reintentar.
JEV_LOG_LEVEL=INFO
JEV_RETRY_MAX_ATTEMPTS=5
JEV_RETRY_BASE_DELAY=2.0
JEV_RETRY_CAP_DELAY=32.0
